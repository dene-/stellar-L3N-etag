# Firmware build environment. The tc32 toolchain is bundled in Firmware/tc32_linux (x86-64 Linux), so
# this only adds make and Python for the makefile's CRC step. Use build_docker.sh, which builds this
# image with no context and mounts the repository at /workspace.
FROM ubuntu:22.04
RUN apt-get update \
	&& apt-get install -y --no-install-recommends make python-is-python3 \
	&& rm -rf /var/lib/apt/lists/*
WORKDIR /workspace/Firmware
